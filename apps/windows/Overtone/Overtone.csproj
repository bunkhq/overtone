<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Overtone</RootNamespace>
    <AssemblyName>Overtone</AssemblyName>
    <Version>0.2.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\overtone.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Repo-relative path to the Rust core. -->
    <CoreDir>$(MSBuildThisFileDirectory)..\..\..\core\</CoreDir>
    <CoreTarget Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</CoreTarget>
    <CoreTarget Condition="'$(CoreTarget)' == ''">x86_64-pc-windows-msvc</CoreTarget>
    <CoreDll>$(CoreDir)target\$(CoreTarget)\release\overtone_core.dll</CoreDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="WinUIEx" Version="2.9.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Build the Rust core (release) before the app and ship its DLL beside the exe.
       Skip with -p:SkipCore=true when iterating on C# only. -->
  <Target Name="BuildCore" BeforeTargets="BeforeBuild" Condition="'$(SkipCore)' != 'true'">
    <Exec Command="cargo build --release --target $(CoreTarget)" WorkingDirectory="$(CoreDir)" />
  </Target>
  <Target Name="CopyCore" AfterTargets="Build">
    <Copy SourceFiles="$(CoreDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(CoreDll)')" />
    <Error Text="Rust core not built: $(CoreDll)" Condition="!Exists('$(CoreDll)')" />
  </Target>
  <Target Name="PublishCore" AfterTargets="Publish">
    <Copy SourceFiles="$(CoreDll)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>

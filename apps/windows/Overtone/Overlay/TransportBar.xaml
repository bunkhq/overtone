<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Overtone.Overlay.TransportBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Overtone.Overlay">
    <!-- Glyphs are drawn on a 16-unit grid; the Viewboxes scale them per size. -->
    <StackPanel Orientation="Horizontal">
        <local:GlowButton x:Name="PrevButton" Style="{StaticResource OvButton}" AutomationProperties.Name="Previous track" Click="OnPrev">
            <Grid>
                <Viewbox x:Name="PrevBox" Width="16" Height="16">
                    <Path Width="16" Height="16" Fill="{StaticResource TitleBrush}"
                          Data="M3,2.5 H4.6 V13.5 H3 Z M14,2.9 V13.1 A0.6,0.6 0 0 1 13.08,13.6 L6,8.5 A0.6,0.6 0 0 1 6,7.5 L13.08,2.4 A0.6,0.6 0 0 1 14,2.9 Z" />
                </Viewbox>
                <FontIcon x:Name="PrevIcon" Glyph="&#xF8AC;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="{StaticResource TitleBrush}" Visibility="Collapsed" />
            </Grid>
        </local:GlowButton>
        <local:GlowButton x:Name="PlayButton" Style="{StaticResource OvButton}" AutomationProperties.Name="Pause" Click="OnPlay">
            <Grid>
            <FontIcon x:Name="PlayIcon" Glyph="&#xF8AE;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="{StaticResource TitleBrush}" Visibility="Collapsed" />
            <Viewbox x:Name="PlayBox" Width="16" Height="16">
                <Grid Width="16" Height="16">
                    <Path x:Name="PauseGlyph" Fill="{StaticResource TitleBrush}"
                          Data="M4.5,2.5 H5.5 A1,1 0 0 1 6.5,3.5 V12.5 A1,1 0 0 1 5.5,13.5 H4.5 A1,1 0 0 1 3.5,12.5 V3.5 A1,1 0 0 1 4.5,2.5 Z M10.5,2.5 H11.5 A1,1 0 0 1 12.5,3.5 V12.5 A1,1 0 0 1 11.5,13.5 H10.5 A1,1 0 0 1 9.5,12.5 V3.5 A1,1 0 0 1 10.5,2.5 Z" />
                    <Path x:Name="PlayGlyph" Fill="{StaticResource TitleBrush}" Visibility="Collapsed"
                          Data="M4.5,2.6 V13.4 A0.7,0.7 0 0 0 5.56,14 L14.16,8.6 A0.7,0.7 0 0 0 14.16,7.4 L5.56,2 A0.7,0.7 0 0 0 4.5,2.6 Z" />
                </Grid>
            </Viewbox>
            </Grid>
        </local:GlowButton>
        <local:GlowButton x:Name="NextButton" Style="{StaticResource OvButton}" AutomationProperties.Name="Next track" Click="OnNext">
            <Grid>
                <Viewbox x:Name="NextBox" Width="16" Height="16">
                    <Path Width="16" Height="16" Fill="{StaticResource TitleBrush}"
                          Data="M11.4,2.5 H13 V13.5 H11.4 Z M2,2.9 V13.1 A0.6,0.6 0 0 0 2.92,13.6 L10,8.5 A0.6,0.6 0 0 0 10,7.5 L2.92,2.4 A0.6,0.6 0 0 0 2,2.9 Z" />
                </Viewbox>
                <FontIcon x:Name="NextIcon" Glyph="&#xF8AD;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="{StaticResource TitleBrush}" Visibility="Collapsed" />
            </Grid>
        </local:GlowButton>
    </StackPanel>
</UserControl>
